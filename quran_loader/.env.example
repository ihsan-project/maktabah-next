# OpenSearch Configuration — SigV4 auth (no username/password)
OPENSEARCH_URL=https://your-opensearch-domain.us-east-1.es.amazonaws.com

# AWS credentials — used for BOTH OpenSearch SigV4 auth and Bedrock embeddings.
# The IAM user must be mapped to an OpenSearch role in Dashboards (see root README).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Node Environment
NODE_ENV=development

# Firebase Configuration
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Optional: Path to your service account JSON file if not provided as command line argument
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccount.json
